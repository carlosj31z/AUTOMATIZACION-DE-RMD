<!--
  DÓNDE: app UI5 «Configuración RMD» del portal (la que se abre en ui5appruntime.html).
  1) En la vista de la lista principal, dentro del MenuButton «Exportar», agregar el MenuItem de abajo.
  2) En la ventana del RMD (diálogo «<código> - <descripción>»), en su barra de botones, junto a «Nueva Versión»,
     agregar el botón «Importar borrador». Visible solo con el rol RMD_Equipo y el RMD Ingresado.
  El controlador está en BorradorBotones.controller-extension.js.
-->
<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

  <!-- 1) Menú Exportar de la lista principal -->
  <MenuItem
    id="miGenerarPlantilla"
    text="Plantilla para Producción"
    icon="sap-icon://document-text"
    press=".borrador.onGenerarPlantilla" />

  <!-- 2) Ventana del RMD, junto a «Nueva Versión» -->
  <Button
    id="btnImportarBorrador"
    text="Revisar borradores de Producción"
    icon="sap-icon://inbox"
    type="Emphasized"
    visible="{= ${detalleRmd>/estadoIdRmd_iMaestraId} === 467 &amp;&amp; ${permisos>/rmdEquipo} }"
    press=".borrador.onAbrirBorradores" />

</core:FragmentDefinition>
