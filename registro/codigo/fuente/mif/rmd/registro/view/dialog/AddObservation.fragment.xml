'<core:FragmentDefinition\r\n\txmlns:core="sap.ui.core"\r\n\txmlns:mvc="sap.ui.core.mvc"\r\n\txmlns="sap.m"\r\n  xmlns:layout="sap.ui.layout"\r\n  xmlns:form="sap.ui.layout.form"><Dialog class="sapUiContentPadding sapUiSizeCompact" title="{i18n>tlObservation} - {modelGeneral>/sDesPaso}" contentWidth="40%" afterClose="onCancelObservation"><content><layout:VerticalLayout width="100%"><form:Form width="100%" editable="true"><form:title><core:Title text="{i18n>tlAnadirObservation}"/></form:title><form:formContainers><form:FormContainer><form:formElements><form:FormElement><form:label><Label text="" design="Bold" width="100%"/></form:label><form:fields><TextArea value="{modelGeneral>/ObservacionRMD}" maxLength="150" width="100%" rows="10" liveChange="onChangeObservation"/></form:fields></form:FormElement><form:FormElement><form:label><Label text="" design="Bold" width="100%"/></form:label><form:fields><List\r\n                        noDataText="{i18n>tblNoData}"\r\n                        showSeparators="Inner"\r\n                        items="{\r\n                            path: \'modelGeneral>/observacionesPaso\',\r\n                            sorter: {\r\n                                path: \'fechaRegistro\',\r\n                                descending: true\r\n                            }\r\n                        }"><FeedListItem\r\n                            text="{modelGeneral>nombre} {modelGeneral>apellido} - {modelGeneral>observacion}"\r\n                            timestamp="{path:\'modelGeneral>fechaRegistro\', type: \'sap.ui.model.type.Date\', formatOptions: {pattern: \'dd/MM/yyyy HH:mm\'}}"/></List></form:fields></form:FormElement></form:formElements><form:title/></form:FormContainer></form:formContainers><form:layout><form:ResponsiveGridLayout adjustLabelSpan="false" columnsL="1" labelSpanL="4" columnsM="1" labelSpanM="4" labelSpanS="12"/></form:layout></form:Form></layout:VerticalLayout></content><beginButton><Button text="{i18n>btnConfirm}" press="onConfirmObservation" type="Accept"/></beginButton><endButton><Button text="{i18n>btnClose}" press="onCancelObservation" type="Reject"/></endButton></Dialog></core:FragmentDefinition>'