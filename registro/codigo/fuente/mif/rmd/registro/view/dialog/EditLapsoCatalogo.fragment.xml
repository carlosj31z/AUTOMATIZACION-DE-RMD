po/Code}"><core:ListItem key="{modelGeneral>Code}" text="{modelGeneral>Shorttxtcd}" additionalText="{modelGeneral>Code}"/></ComboBox></form:fields></form:FormElement><form:FormElement><form:label><Label text="{i18n>clComment}" design="Bold" width="100%" required="true"/></form:label><form:fields><TextArea id="tAreaMotivo" value="{modelGeneral>/objEdit/comentario}" change="onCheckMotivosEdit" maxLength="1000" width="100%" rows="20"/></form:fields></form:FormElement></form:formElements></form:FormContainer></form:formContainers><form:layout><form:ResponsiveGridLayout adjustLabelSpan="false" columnsL="1" labelSpanL="4" columnsM="1" labelSpanM="4" labelSpanS="12"/></form:layout></form:Form></layout:VerticalLayout></content><beginButton><Button enabled="{modelGeneral>/addLapsoEnabledEdit}" text="{i18n>btnConfirm}" press="onSaveChangesEdit" type="Accept"/></beginButton><endButton><Button text="{i18n>btnClose}" press="onCancelLapsoEdit" type="Reject"/></endButton></Dialog></core:FragmentDefinition>'