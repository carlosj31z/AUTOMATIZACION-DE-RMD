'<core:FragmentDefinition xmlns:core="sap.ui.core"\r\n    xmlns="sap.m"\r\n    xmlns:layout="sap.ui.layout"\r\n    xmlns:form="sap.ui.layout.form" xmlns:fb="sap.ui.comp.filterbar" xmlns:mvc="sap.ui.core.mvc" ><Dialog class="sapUiContentPadding sapUiSizeCompact" title="{i18n>tlListEtiqueta}" contentWidth="80%" afterClose="onCancelListEtiquetaSinEnlace"><content><Table width="auto" sticky="ColumnHeaders" items="{path:\'modelGeneral>/ListaEtiqueta\'}" updateFinished="onUpdateFinish" noDataText="{i18n>tblNoData}" itemPress="onDetailRmd" mode="MultiSelect"><headerToolbar><OverflowToolbar><Title text="{i18n>tblEtiqueta}"></Title><ToolbarSpacer/><ToolbarSeparator/><OverflowToolbarButton tooltip="{i18n>btnAgregar}" icon="sap-icon://add" press="onAddEtiquetaControl" type="Transparent" visible="{=${visibleAddControlTickets>/state} &amp;&amp; ${generalModelState>/state} ? true : false}"/><OverflowToolbarButton tooltip="{i18n>TbEPrint}" icon="sap-icon://print" press="onPrintTicket(1)" type="Transparent"/><OverflowToolbarButton tooltip="{i18n>TbEDeleteTicket}" icon="sap-icon://delete" press="onDeleteEtiquetaControlMasivo" type="Transparent" enabled="{=${visibleAddControlTickets>/state} &amp;&amp; ${generalModelState>/state} ? true : false}"/></OverflowToolbar></headerToolbar><columns><Column width="10%" hAlign="Left" vAlign="Middle" minScreenWidth="" demandPopin="false" popinDisplay="WithoutHeader" mergeDuplicates="false" styleClass="cellBorderLeft cellBorderRight"><Text text="{i18n>clOrden}" wrapping="true"/></Column><Column width="10%" hAlign="Left" vAlign="Middle" minScreenWidth="Tablet" demandPopin="false" popinDisplay="WithoutHeader" mergeDuplicates="false" styleClass="cellBorderRight"><Text text="{i18n>clCantidadOrden}" wrapping="true"/></Column><Column width="10%" hAlign="Left" vAlign="Middle" minScreenWidth="Tablet" demandPopin="false" popinDisplay="WithoutHeader" mergeDuplicates="false" styleClass="cellBorderRight"><Text text="{cantidadCopiasUnidadesI18n>/state}" wrappi