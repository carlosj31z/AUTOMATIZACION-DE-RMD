n}" width="auto" wrapping="true"/><Text text="{modelGeneral>cantidadOrden}" width="auto" wrapping="true"/><Input value="{modelGeneral>cantidadUnidad}" type="Number" enabled="{generalModelState>/state}" width="auto"/><Text text="{modelGeneral>secuencia}" width="auto" wrapping="true"/><Switch state="{path: \'modelGeneral>impresion\', formatter: \'.formatter.formatFlag\'}" customTextOn="SI" customTextOff="NO" enabled="false"/><Text text="{path: \'modelGeneral>fechaImpresion\', type: \'sap.ui.model.type.Date\', formatOptions: { pattern: \'dd/MM/yyyy HH:mm:ss\', UTC: false }}" width="auto" wrapping="true"/><Text text="{modelGeneral>reimpresion}" width="auto" wrapping="true"/><Text text="{path: \'modelGeneral>fechaReimpresion\', type: \'sap.ui.model.type.Date\', formatOptions: { pattern: \'dd/MM/yyyy HH:mm:ss\', UTC: false }}" width="auto" wrapping="true"/><Text text="{modelGeneral>observacion}" width="auto" wrapping="true"/><Button icon="sap-icon://save" tooltip="{i18n>tltEditar}" type="Transparent" text="" press="onEditEtiquetaControl" enabled="{generalModelState>/state}"/><Button icon="sap-icon://delete" tooltip="{i18n>tltEliminar}" type="Transparent" text="" press="onDeleteEtiquetaControl" enabled="{generalModelState>/state}"/></cells></ColumnListItem></items></Table></content><endButton><Button text="{i18n>btnClose}" press="onCancelListEtiquetaSinEnlace" type="Reject"/></endButton></Dialog></core:FragmentDefinition>'