# URL del Fiori Launchpad de RMD, app "Configuración" (confirmada navegando
# sin credenciales hasta la pantalla de login real de Medifarma):
RMD_LAUNCHPAD_URL=https://medifarma-portal-prd-twuxor0u.cpp.cfapps.us10.hana.ondemand.com/site/portalprd#configuracion-display?sap-ui-app-id-hint=saas_approuter_mif.rmd.configuracion

# Credenciales del usuario técnico/de servicio autorizado para automatización.
# Usar una cuenta de servicio sin MFA interactivo, nunca una cuenta personal.
# NUNCA subir este archivo con valores reales al repositorio (usar .env local).
RMD_USERNAME=
RMD_PASSWORD=

RMD_HEADLESS=true
RMD_TIMEOUT_MS=30000
